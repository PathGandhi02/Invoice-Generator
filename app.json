{
  "expo": {
    "name": "GigaInvoice",
    "slug": "gigainvoice",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "gigainvoice",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marutigigafiber.gigainvoice",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.marutigigafiber.gigainvoice",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f19"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#0b0f19"
        }
      ],
      "expo-document-picker",
      "expo-status-bar",
      "expo-sharing"
    ]
  }
}
