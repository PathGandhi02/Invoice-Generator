{
  "name": "gigainvoice",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "native:android": "expo run:android",
    "native:ios": "expo run:ios",
    "web": "expo start --web",
    "build": "npm run export:web",
    "export:web": "expo export --platform web && node scripts/prepare-web.mjs",
    "preview": "node scripts/serve-web.mjs",
    "export:android": "expo export --platform android --output-dir dist-android",
    "prepare:customers": "node --import tsx scripts/prepare-customers.ts",
    "prepare:assets": "node --import tsx scripts/prepare-assets.ts",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build:apk": "npx eas-cli build -p android --profile preview"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/metro-runtime": "~57.0.15",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.20",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "html2pdf.js": "^0.14.0",
    "lucide-react-native": "^1.45.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
